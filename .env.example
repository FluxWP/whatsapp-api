# Copy to the host environment. Do not commit real values.
# Settings list: README.md

PORT=3000
FLXW_DATA_DIR=
# Message retention in days. Default 45 (1–3650). Empty keeps the default.
# Startup and every 6 hours. Does not delete session keys or contacts.
FLXW_MSG_KEEP_DAYS=
FLXW_API_KEY=
FLXW_PUBLIC_URL=
FLXW_DB_HOST=
FLXW_DB_PORT=3306
FLXW_DB_NAME=
FLXW_DB_USER=
FLXW_DB_PASSWORD=
FLXW_DB_PREFIX=flxw_

# First admin password. Leave empty to use the one-time setup token.
FLXW_ADMIN_PASSWORD=
# Optional. If empty, the server prints a generated token once in the log.
FLXW_SETUP_TOKEN=

# Off by default. Hop count (1) or a proxy IP/CIDR list. "true" is ignored.
FLXW_TRUST_PROXY=
# 1 allows webhook/media fetches to RFC1918, loopback and IPv6 ULA. Metadata stays blocked.
FLXW_ALLOW_PRIVATE_URLS=

# off hides /admin
FLXW_PANEL=
FLXW_LOG=info
